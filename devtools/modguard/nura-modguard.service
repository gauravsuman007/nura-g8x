[Unit]
Description=Match /lib/modules to the running kernel build (development guard)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udev-trigger.service systemd-modules-load.service systemd-udevd.service
RequiresMountsFor=/var/lib /lib/modules

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nura-modguard
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
