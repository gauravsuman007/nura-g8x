+/* nura (LG G8x): IMX363 uses the same 512-based Sony gain code as IMX258. */
+class CameraSensorHelperImx363 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx363()
+	{
+		blackLevel_ = 4096;	/* 64 at 10 bits */
+		gain_ = AnalogueGainLinear{ 0, 512, -1, 512 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx363", CameraSensorHelperImx363)
+
+/* nura: Samsung S5K sensors, analogue gain = code / 32 (0x20 = 1x). */
+class CameraSensorHelperS5kLinear32 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5kLinear32()
+	{
+		blackLevel_ = 4096;	/* 64 at 10 bits */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+class CameraSensorHelperS5k3m3 : public CameraSensorHelperS5kLinear32
+{
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3m3", CameraSensorHelperS5k3m3)
+
+class CameraSensorHelperS5kgd1 : public CameraSensorHelperS5kLinear32
+{
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5kgd1", CameraSensorHelperS5kgd1)
+
