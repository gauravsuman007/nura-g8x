9ab77282352dfec33408d0fdbb53b2bb12b4fc5b73e510354ed984ada216be91f204456f01b7b93aebf304834059f2c4c034a5b99bfd4ae02fa8d4497791d9cf  0001-nura-lg-mh2lm.patch
49effaaa88cb389de54434fc98b9820d71a5dca880df6ad16a558476c41f96c051b63eaea5a24e452d4d3106b90e7df59cfdcc4fe73a56c83e821011b128c539  config-nura-lg-mh2lm.aarch64
"
