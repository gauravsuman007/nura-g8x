+static bool hold_mode = true;
+
+/*
+ * Program the charge pause the user asked for. The driver owns this state:
+ * the PMIC does not keep a paused charger paused across input re-detection
+ * (cable replug, APSD rerun), so this is called again from the plug-in
+ * interrupt and after every charger type detection.
+ *
+ * In hold mode charging is paused with CHARGING_ENABLE_CMD and the USB input
+ * stays on (the device runs from the charger); otherwise the USB input is
+ * suspended and the battery supplies the device.
+ */
+static int smb_apply_charge_pause(struct smb_chip *chip)
+{
+	bool paused, hold;
+	int rc;
+
+	mutex_lock(&chip->pause_lock);
+	paused = chip->charge_paused;
+	hold = READ_ONCE(hold_mode);
+
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				USBIN_SUSPEND_BIT,
+				paused && !hold ? USBIN_SUSPEND_BIT : 0);
+	if (!rc)
+		rc = regmap_update_bits(chip->regmap,
+					chip->base + CHARGING_ENABLE_CMD,
+					CHARGING_ENABLE_CMD_BIT,
+					paused && hold ? 0 : CHARGING_ENABLE_CMD_BIT);
+	mutex_unlock(&chip->pause_lock);
+
+	if (rc)
+		dev_err(chip->dev, "Couldn't %s charging: %d\n",
+			paused ? "pause" : "enable", rc);
+	return rc;
+}
