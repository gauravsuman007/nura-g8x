From a888ff165d86b1d89b666e39f7eaf86c02fe9f69 Mon Sep 17 00:00:00 2001
From: Nura G8x <nura-g8x@users.noreply.github.com>
Date: Thu, 26 Nov 2026 16:58:34 +0100
Subject: [PATCH] wifi: ath10k: keep the MSA regions assigned across a modem
 crash

On WCN3990 the WLAN firmware runs as part of the modem. When the modem
crashes, ath10k_qmi_event_server_exit() hands the MSA regions back to
HLOS while the modem is still to be shut down and restarted. On SM8150
(LG G8X) this resets the whole SoC during the modem restart, with no
message in the kernel log.

Reproduce with Wi-Fi up:
  echo 1 > /sys/kernel/debug/remoteproc/remoteprocN/crash
The log ends after "ipa: received modem starting event". With the
regions left assigned the modem and Wi-Fi recover (5 crashes in a row
on one boot). The same reset turned a modem watchdog during suspend
into a hard lockup of the AP.

Keep the regions assigned when the QMI server goes away because of a
crash, and skip the assignment on the following setup. A deliberate
stop or driver removal behaves as before.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/drivers/net/wireless/ath/ath10k/qmi.c b/drivers/net/wireless/ath/ath10k/qmi.c
index eebd78e..cfaea77 100644
--- a/drivers/net/wireless/ath/ath10k/qmi.c
+++ b/drivers/net/wireless/ath/ath10k/qmi.c
@@ -90,7 +90,7 @@ static int ath10k_qmi_setup_msa_permissions(struct ath10k_qmi *qmi)
 	int ret;
 	int i;
 
-	if (qmi->msa_fixed_perm)
+	if (qmi->msa_fixed_perm || qmi->msa_mapped)
 		return 0;
 
 	for (i = 0; i < qmi->nr_mem_region; i++) {
@@ -99,6 +99,8 @@ static int ath10k_qmi_setup_msa_permissions(struct ath10k_qmi *qmi)
 			goto err_unmap;
 	}
 
+	qmi->msa_mapped = true;
+
 	return 0;
 
 err_unmap:
@@ -111,9 +113,11 @@ static void ath10k_qmi_remove_msa_permission(struct ath10k_qmi *qmi)
 {
 	int i;
 
-	if (qmi->msa_fixed_perm)
+	if (!qmi->msa_mapped)
 		return;
 
+	qmi->msa_mapped = false;
+
 	for (i = 0; i < qmi->nr_mem_region; i++)
 		ath10k_qmi_unmap_msa_permission(qmi, &qmi->mem_region[i]);
 }
@@ -898,10 +902,17 @@ static void ath10k_qmi_event_server_exit(struct ath10k_qmi *qmi)
 	struct ath10k *ar = qmi->ar;
 	struct ath10k_snoc *ar_snoc = ath10k_snoc_priv(ar);
 
-	ath10k_qmi_remove_msa_permission(qmi);
+	bool crashed = !test_bit(ATH10K_SNOC_FLAG_UNREGISTERING, &ar_snoc->flags) &&
+		       !test_bit(ATH10K_SNOC_FLAG_MODEM_STOPPED, &ar_snoc->flags);
+
+	/* After a crash the WLAN hardware can still be using the MSA regions
+	 * while the modem is restarted; taking them back then resets the SoC.
+	 * Leave them assigned, the next setup finds them mapped.
+	 */
+	if (!crashed)
+		ath10k_qmi_remove_msa_permission(qmi);
 	ath10k_core_free_board_files(ar);
-	if (!test_bit(ATH10K_SNOC_FLAG_UNREGISTERING, &ar_snoc->flags) &&
-	    !test_bit(ATH10K_SNOC_FLAG_MODEM_STOPPED, &ar_snoc->flags))
+	if (crashed)
 		ath10k_snoc_fw_crashed_dump(ar);
 
 	ath10k_snoc_fw_indication(ar, ATH10K_QMI_EVENT_FW_DOWN_IND);
diff --git a/drivers/net/wireless/ath/ath10k/qmi.h b/drivers/net/wireless/ath/ath10k/qmi.h
index 0816eb4..f963807 100644
--- a/drivers/net/wireless/ath/ath10k/qmi.h
+++ b/drivers/net/wireless/ath/ath10k/qmi.h
@@ -107,6 +107,7 @@ struct ath10k_qmi {
 	char fw_build_timestamp[MAX_TIMESTAMP_LEN + 1];
 	struct ath10k_qmi_cal_data cal_data[MAX_NUM_CAL_V01];
 	bool msa_fixed_perm;
+	bool msa_mapped;
 	bool no_msa_ready_indicator;
 	enum ath10k_qmi_state state;
 };
