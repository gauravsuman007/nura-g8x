+	dev_dbg(core->dev,
+		 "Iris1 v57: setting LLCC resources: id=%u size=%u KiB, id=%u size=%u KiB\n",
+		 pkt->data[2], pkt->data[1], pkt->data[4], pkt->data[3]);
