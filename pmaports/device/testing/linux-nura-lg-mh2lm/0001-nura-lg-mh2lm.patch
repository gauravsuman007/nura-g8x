+	pkt->hdr.size = packet_size;
+	pkt->hdr.pkt_type = HFI_CMD_SYS_SET_RESOURCE;
+	pkt->resource_handle = 1;
+	pkt->resource_type = HFI_RESOURCE_SYSCACHE;
+	pkt->data[0] = ARRAY_SIZE(usecase_ids);
+	for (i = 0; i < ARRAY_SIZE(usecase_ids); i++) {
