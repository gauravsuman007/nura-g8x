+		.shdr.hdr.size = sizeof(packet),
+		.shdr.hdr.pkt_type = HFI_CMD_SESSION_GET_PROPERTY,
+		.shdr.session_id = inst->session_id,
+		.num_properties = 1,
+		.data = HFI_PROPERTY_CONFIG_BUFFER_REQUIREMENTS,
+	};
