+static void qcom_fg_set_charge_paused(struct qcom_fg_chip *chip, bool pause)
+{
+	union power_supply_propval val = { .intval = !pause };
+	int ret;
+
+	ret = power_supply_set_property(chip->chg_psy, POWER_SUPPLY_PROP_STATUS,
+					&val);
