diff --git a/drivers/net/ipa/ipa_endpoint.c b/drivers/net/ipa/ipa_endpoint.c
index 0bd9b9f..5d62d98 100644
--- a/drivers/net/ipa/ipa_endpoint.c
+++ b/drivers/net/ipa/ipa_endpoint.c
@@ -1881,24 +1881,29 @@ void ipa_endpoint_suspend_one(struct ipa_endpoint *endpoint)
 			endpoint->channel_id);
 }
 
-void ipa_endpoint_resume_one(struct ipa_endpoint *endpoint)
+int ipa_endpoint_resume_one(struct ipa_endpoint *endpoint)
 {
 	struct device *dev = endpoint->ipa->dev;
 	struct gsi *gsi = &endpoint->ipa->gsi;
 	int ret;
 
 	if (!test_bit(endpoint->endpoint_id, endpoint->ipa->enabled))
-		return;
+		return 0;
 
 	if (!endpoint->toward_ipa)
 		(void)ipa_endpoint_program_suspend(endpoint, false);
 
 	ret = gsi_channel_resume(gsi, endpoint->channel_id);
-	if (ret)
+	if (ret) {
 		dev_err(dev, "error %d resuming channel %u\n", ret,
 			endpoint->channel_id);
-	else if (!endpoint->toward_ipa)
+		return ret;
+	}
+
+	if (!endpoint->toward_ipa)
 		ipa_endpoint_replenish_enable(endpoint);
+
+	return 0;
 }
 
 void ipa_endpoint_suspend(struct ipa *ipa)
@@ -1913,16 +1918,35 @@ void ipa_endpoint_suspend(struct ipa *ipa)
 	ipa_endpoint_suspend_one(ipa->name_map[IPA_ENDPOINT_AP_COMMAND_TX]);
 }
 
-void ipa_endpoint_resume(struct ipa *ipa)
+int ipa_endpoint_resume(struct ipa *ipa)
 {
+	struct ipa_endpoint *command_tx;
+	int ret;
+
 	if (!ipa->setup_complete)
-		return;
+		return 0;
 
-	ipa_endpoint_resume_one(ipa->name_map[IPA_ENDPOINT_AP_COMMAND_TX]);
-	ipa_endpoint_resume_one(ipa->name_map[IPA_ENDPOINT_AP_LAN_RX]);
+	/* The AP command TX channel carries the immediate commands the
+	 * driver waits for synchronously (gsi_trans_commit_wait()), and
+	 * completions for them arrive on the AP LAN RX channel.  If either
+	 * fails to restart, a transaction committed later would never
+	 * complete, so report the failure rather than resume "successfully".
+	 */
+	command_tx = ipa->name_map[IPA_ENDPOINT_AP_COMMAND_TX];
+	ret = ipa_endpoint_resume_one(command_tx);
+	if (ret)
+		return ret;
+
+	ret = ipa_endpoint_resume_one(ipa->name_map[IPA_ENDPOINT_AP_LAN_RX]);
+	if (ret) {
+		ipa_endpoint_suspend_one(command_tx);
+		return ret;
+	}
 
 	if (ipa->modem_netdev)
 		ipa_modem_resume(ipa->modem_netdev);
+
+	return 0;
 }
 
 static void ipa_endpoint_setup_one(struct ipa_endpoint *endpoint)
