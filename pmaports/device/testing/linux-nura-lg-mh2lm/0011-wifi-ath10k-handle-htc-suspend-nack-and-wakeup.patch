diff --git a/drivers/net/wireless/ath/ath10k/core.c b/drivers/net/wireless/ath/ath10k/core.c
index c645f8d..609c1cc 100644
--- a/drivers/net/wireless/ath/ath10k/core.c
+++ b/drivers/net/wireless/ath/ath10k/core.c
@@ -811,13 +811,25 @@ void ath10k_core_get_fw_features_str(struct ath10k *ar,
 	}
 }
 
-static void ath10k_send_suspend_complete(struct ath10k *ar)
+static void ath10k_send_suspend_complete(struct ath10k *ar, bool ack)
 {
-	ath10k_dbg(ar, ATH10K_DBG_BOOT, "boot suspend complete\n");
+	ath10k_dbg(ar, ATH10K_DBG_BOOT, "boot suspend complete %d\n", ack);
 
+	ar->target_suspend_ack = ack;
 	complete(&ar->target_suspend);
 }
 
+static void ath10k_wakeup_from_suspend(struct ath10k *ar)
+{
+	ath10k_dbg(ar, ATH10K_DBG_BOOT, "wakeup from suspend requested\n");
+
+	/* The target saw a wake event after it acked the suspend. Abort a
+	 * system suspend in progress so that resume tells the target the
+	 * host is awake again.
+	 */
+	pm_wakeup_dev_event(ar->dev, 0, true);
+}
+
 static int ath10k_init_sdio(struct ath10k *ar, enum ath10k_firmware_mode mode)
 {
 	bool mtu_workaround = ar->hw_params.credit_size_workaround;
@@ -3043,6 +3055,8 @@ int ath10k_core_start(struct ath10k *ar, enum ath10k_firmware_mode mode,
 
 	ar->htc.htc_ops.target_send_suspend_complete =
 		ath10k_send_suspend_complete;
+	ar->htc.htc_ops.target_wakeup_from_suspend =
+		ath10k_wakeup_from_suspend;
 
 	status = ath10k_htc_init(ar);
 	if (status) {
@@ -3310,6 +3324,7 @@ int ath10k_wait_for_suspend(struct ath10k *ar, u32 suspend_opt)
 	unsigned long time_left;
 
 	reinit_completion(&ar->target_suspend);
+	ar->target_suspend_ack = false;
 
 	ret = ath10k_wmi_pdev_suspend_target(ar, suspend_opt);
 	if (ret) {
@@ -3324,6 +3339,11 @@ int ath10k_wait_for_suspend(struct ath10k *ar, u32 suspend_opt)
 		return -ETIMEDOUT;
 	}
 
+	if (!ar->target_suspend_ack) {
+		ath10k_warn(ar, "target refused suspend\n");
+		return -EBUSY;
+	}
+
 	return 0;
 }
 
diff --git a/drivers/net/wireless/ath/ath10k/core.h b/drivers/net/wireless/ath/ath10k/core.h
