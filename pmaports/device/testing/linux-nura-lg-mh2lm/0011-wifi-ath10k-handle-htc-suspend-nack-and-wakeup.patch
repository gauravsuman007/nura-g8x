@@ -1063,6 +1063,8 @@ struct ath10k {
 	} hif;
 
 	struct completion target_suspend;
+	/* target acked (true) or refused (false) the last suspend request */
+	bool target_suspend_ack;
 	struct completion driver_recovery;
 
 	const struct ath10k_hw_regs *regs;
diff --git a/drivers/net/wireless/ath/ath10k/htc.c b/drivers/net/wireless/ath/ath10k/htc.c
index ce9b248..a117c16 100644
--- a/drivers/net/wireless/ath/ath10k/htc.c
+++ b/drivers/net/wireless/ath/ath10k/htc.c
@@ -558,10 +558,17 @@ static void ath10k_htc_control_rx_complete(struct ath10k *ar,
 		complete(&htc->ctl_resp);
 		break;
 	case ATH10K_HTC_MSG_SEND_SUSPEND_COMPLETE:
-		htc->htc_ops.target_send_suspend_complete(ar);
+		htc->htc_ops.target_send_suspend_complete(ar, true);
+		break;
+	case ATH10K_HTC_MSG_NACK_SUSPEND:
+		htc->htc_ops.target_send_suspend_complete(ar, false);
+		break;
+	case ATH10K_HTC_MSG_WAKEUP_FROM_SUSPEND_ID:
+		htc->htc_ops.target_wakeup_from_suspend(ar);
 		break;
 	default:
-		ath10k_warn(ar, "ignoring unsolicited htc ep0 event\n");
+		ath10k_warn(ar, "ignoring unsolicited htc ep0 event %u\n",
+			    __le16_to_cpu(msg->hdr.message_id));
 		break;
 	}
 
