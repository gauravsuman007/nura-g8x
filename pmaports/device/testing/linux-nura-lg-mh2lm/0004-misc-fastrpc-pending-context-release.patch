 	spin_unlock_irqrestore(&cctx->lock, flags);
 
 	if (!ctx) {
@@ -2536,10 +2622,11 @@ static int fastrpc_rpmsg_callback(struct rpmsg_device *rpdev, void *data,
 
 	/*
 	 * The DMA buffer associated with the context cannot be freed in
-	 * interrupt context so schedule it through a worker thread to
-	 * avoid a kernel BUG.
+	 * interrupt context so drop the answer's reference through a worker
+	 * thread to avoid a kernel BUG. That reference keeps ctx alive here
+	 * after the caller has been woken, and ctx keeps its fl alive.
 	 */
-	schedule_work(&ctx->put_work);
+	queue_work(fastrpc_wq, &ctx->put_work);
 
