+		struct device_node *rmem_np;
 		struct resource res;
+		bool reusable;
 		u64 src_perms;
 
+		/*
+		 * The whole region is handed to the DSP VMs below and never
+		 * given back. A reusable (CMA) region stays in use by the page
+		 * allocator, so its pages would end up as page cache, user
+		 * memory or kernel data that HLOS may not execute and the DSP
+		 * may write. The region must be a no-map carveout.
+		 */
+		rmem_np = of_parse_phandle(rdev->of_node, "memory-region", 0);
+		reusable = of_property_read_bool(rmem_np, "reusable");
+		of_node_put(rmem_np);
+		if (reusable) {
+			dev_err(rdev, "reusable memory-region cannot be assigned to the DSP\n");
+			err = -EINVAL;
+			goto err_free_data;
+		}
+
 		err = of_reserved_mem_region_to_resource(rdev->of_node, 0, &res);
 		if (!err) {
 			src_perms = BIT(QCOM_SCM_VMID_HLOS);
@@ -2469,9 +2548,14 @@ static void fastrpc_notify_users(struct fastrpc_user *user)
 {
 	struct fastrpc_invoke_ctx *ctx;
 
