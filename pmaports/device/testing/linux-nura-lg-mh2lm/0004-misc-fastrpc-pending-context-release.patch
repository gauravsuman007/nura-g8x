+/*
+ * fastrpc_invoke_send() takes a reference for the DSP's answer. Whoever takes
+ * the context out of the idr owns that reference: the answer, a release that
+ * gives up on the call, or the channel going away. Called with cctx->lock held.
+ */
+static bool fastrpc_context_take_answer(struct fastrpc_channel_ctx *cctx,
+					struct fastrpc_invoke_ctx *ctx)
+{
+	lockdep_assert_held(&cctx->lock);
+
+	if (idr_find(&cctx->ctx_idr, ctx->ctxid >> 4) != ctx)
+		return false;
+
+	idr_remove(&cctx->ctx_idr, ctx->ctxid >> 4);
+	return true;
+}
