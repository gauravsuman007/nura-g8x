From 4afe744b3be245407adfa10480fdadd17ffc9572 Mon Sep 17 00:00:00 2001
From: Nura G8x <nura-g8x@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:44:00 +0100
Subject: [PATCH] misc: fastrpc: don't free maps under a late DSP answer

Closing /dev/fastrpc-sdsp right before suspend (nura-sensors-sleep) let a
late DSP answer run put_work after fastrpc_device_release() had freed the
maps and fl: NULL deref in fastrpc_context_put, or a hard reset.
Release now removes pending contexts from the idr and flushes their
put_work before dropping them; context_free only removes its own id.
---
diff --git a/drivers/misc/fastrpc.c b/drivers/misc/fastrpc.c
index dc30303..a9a50c8 100644
--- a/drivers/misc/fastrpc.c
+++ b/drivers/misc/fastrpc.c
@@ -514,7 +514,9 @@ static void fastrpc_context_free(struct kref *ref)
 		fastrpc_buf_free(ctx->buf);
 
 	spin_lock_irqsave(&cctx->lock, flags);
-	idr_remove(&cctx->ctx_idr, ctx->ctxid >> 4);
+	/* release may have removed it already and the id been reused */
+	if (idr_find(&cctx->ctx_idr, ctx->ctxid >> 4) == ctx)
+		idr_remove(&cctx->ctx_idr, ctx->ctxid >> 4);
 	spin_unlock_irqrestore(&cctx->lock, flags);
 
 	kfree(ctx->maps);
@@ -1586,6 +1588,9 @@ static int fastrpc_device_release(struct inode *inode, struct file *file)
 
 	fastrpc_release_current_dsp_process(fl);
 
+	/* answered calls of this fl may still have a put_work queued that touches fl and its maps */
+	flush_scheduled_work();
+
 	spin_lock_irqsave(&cctx->lock, flags);
 	list_del(&fl->user);
 	spin_unlock_irqrestore(&cctx->lock, flags);
@@ -1595,6 +1600,18 @@ static int fastrpc_device_release(struct inode *inode, struct file *file)
 
 	list_for_each_entry_safe(ctx, n, &fl->pending, node) {
 		list_del(&ctx->node);
+		/*
+		 * The DSP may still answer this call. Take the context out of
+		 * the idr so a late answer finds nothing, and let an answer that
+		 * already arrived finish its put_work while the maps and fl it
+		 * touches are still alive. A call that is never answered keeps
+		 * its DSP reference and is leaked instead of freed under us.
+		 */
+		spin_lock_irqsave(&cctx->lock, flags);
+		if (idr_find(&cctx->ctx_idr, ctx->ctxid >> 4) == ctx)
+			idr_remove(&cctx->ctx_idr, ctx->ctxid >> 4);
+		spin_unlock_irqrestore(&cctx->lock, flags);
+		flush_work(&ctx->put_work);
 		fastrpc_context_put(ctx);
 	}
 
@@ -2532,14 +2549,17 @@ static int fastrpc_rpmsg_callback(struct rpmsg_device *rpdev, void *data,
 	}
 
 	ctx->retval = rsp->retval;
-	complete(&ctx->work);
 
 	/*
 	 * The DMA buffer associated with the context cannot be freed in
 	 * interrupt context so schedule it through a worker thread to
-	 * avoid a kernel BUG.
+	 * avoid a kernel BUG. Queue it before waking the caller: the caller
+	 * still holds a reference until then, and once it returns the work
+	 * is already queued, so fastrpc_device_release() can flush it before
+	 * it frees the fl and maps the work still touches.
 	 */
 	schedule_work(&ctx->put_work);
+	complete(&ctx->work);
 
 	return 0;
 }
-- 
