+}
+
+static void fastrpc_user_put(struct fastrpc_user *fl)
+{
+	kref_put(&fl->refcount, fastrpc_user_free);
+}
+
+static int fastrpc_device_release(struct inode *inode, struct file *file)
+{
+	struct fastrpc_user *fl = (struct fastrpc_user *)file->private_data;
+	struct fastrpc_channel_ctx *cctx = fl->cctx;
+	struct fastrpc_invoke_ctx *ctx, *n;
+	unsigned long flags;
+	bool answer;
+
+	/* the DSP process is gone after this, it answers nothing more */
+	fastrpc_release_current_dsp_process(fl);
+
+	spin_lock_irqsave(&cctx->lock, flags);
+	list_del(&fl->user);
+	spin_unlock_irqrestore(&cctx->lock, flags);
+
+	/*
+	 * Calls whose caller was interrupted or timed out. If the answer has
+	 * not arrived, take its reference here; a late answer then finds no
+	 * context. If it has, its put_work drops that reference. Either way
+	 * the context keeps fl alive until it is freed.
+	 */
+	list_for_each_entry_safe(ctx, n, &fl->pending, node) {
+		list_del(&ctx->node);
+		spin_lock_irqsave(&cctx->lock, flags);
+		answer = fastrpc_context_take_answer(cctx, ctx);
+		spin_unlock_irqrestore(&cctx->lock, flags);
+		if (answer)
+			fastrpc_context_put(ctx);
+		fastrpc_context_put(ctx);
+	}
+
 	file->private_data = NULL;
+	fastrpc_user_put(fl);
 
 	return 0;
 }
