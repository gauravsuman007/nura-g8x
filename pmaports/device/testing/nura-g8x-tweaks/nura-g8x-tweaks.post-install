#!/bin/sh
# enable services, apply settings, patch GNOME's SensorDaemon
systemctl daemon-reload 2>/dev/null
systemctl enable nura-tweaks-apply.service nura-firmware-loader.service nura-standby.service nura-gyro.service nura-touch-guard.service \
	nura-sensor-check.service 2>/dev/null
systemctl --global enable nura-dock.service nura-tweaks-user.service 2>/dev/null
systemctl --global disable usb-moded-notify.service 2>/dev/null
# older hand installs (release/install.sh, /usr/local) are superseded
rm -f /etc/systemd/system/hexagonrpcd-sdsp.service.d/*lg*.conf \
	/etc/systemd/system/iio-sensor-proxy.service.d/*lg*.conf 2>/dev/null
systemctl disable nura-keys.service 2>/dev/null
# r9: the r7 loader copied the LG sensor registry as uid 1000, mode 0600: hexagonrpcd (fastrpc) could not read it and no sensors started
chown -R fastrpc:fastrpc /usr/share/qcom/sm8150/LG/mh2lm/sensors 2>/dev/null
chmod 0644 /usr/share/qcom/sm8150/LG/mh2lm/sensors/registry/* 2>/dev/null
# fingerprint: egistad, polkit dialogs accept a finger, greeter stays password-only (dconf)
rm -f /etc/systemd/system/egistad.service /etc/systemd/system/fprintd.service.d/egista.conf 2>/dev/null	# bench installs
systemctl enable egistad.service 2>/dev/null
# polkit-1 belongs to polkit: insert (once) the reason note and the fingerprint before the password
sed -i '/nura-fp-reason/d; /pam_fprintd.so max-tries/d' /etc/pam.d/polkit-1 2>/dev/null
sed -i 's/^auth\([[:space:]]*\)required\([[:space:]]*\)pam_unix.so/auth\1optional\2pam_exec.so quiet seteuid \/usr\/libexec\/nura-fp-reason\nauth\1sufficient\2pam_fprintd.so max-tries=3 timeout=30\n&/' /etc/pam.d/polkit-1
dconf update 2>/dev/null
# OTA: watch /boot/boot.img and bring the boot partition up to date now (a kernel upgraded in this same apk run)
systemctl enable --now nura-boot-update.path 2>/dev/null
/usr/libexec/nura-boot-update 2>&1 | sed 's/^/  /'
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null
/usr/libexec/nura-sensordaemon-fix >/dev/null 2>&1
udevadm control --reload 2>/dev/null
udevadm trigger -c add -s backlight -s power_supply 2>/dev/null
/usr/libexec/nura-tweaks-helper apply 2>/dev/null
systemctl daemon-reload 2>/dev/null
echo "  LG G8x Tweaks installed: open the 'LG G8x Tweaks' app. Restart the phone to start every service."
exit 0
