#!/bin/sh
systemctl disable nura-tweaks-apply.service nura-standby.service nura-gyro.service nura-touch-guard.service \
	nura-sensor-check.service 2>/dev/null
systemctl --global disable nura-dock.service 2>/dev/null
sed -i "/pam_fprintd.so max-tries=2 timeout=15/d" /etc/pam.d/polkit-1 2>/dev/null
systemctl disable egistad.service 2>/dev/null
exit 0
