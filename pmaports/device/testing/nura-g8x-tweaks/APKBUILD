# Maintainer: Nura G8x <nura-g8x@users.noreply.github.com>
# All LG G8x userspace tweaks in one package, configured with the
# "LG G8x Tweaks" app (/etc/nura/tweaks.conf). Built from this repository:
# tweaks/stage.sh packs unit/ and tweaks/ into nura-g8x-tweaks-files.tar.gz.
pkgname=nura-g8x-tweaks
pkgver=2026.11.12
pkgrel=28
_hexver=0.5.0
_sscver=0.4.4
_fpver=1.94.9
pkgdesc="LG G8x ThinQ tweaks: buttons, wake, pocket and dock modes, sensors, camera, settings app"
url="https://github.com/gauravsuman007/nura-g8x"
arch="aarch64"
license="GPL-3.0-or-later AND MIT"
depends="
	glib-dev
	libadwaita
	polkit
	py3-gobject3
	python3
	iw
	iio-sensor-proxy
	linux-firmware-rtl_nic
	hexagonrpcd
	libssc
	qrtr-libs
	libqmi
	protobuf-c
	libgudev
	libcamera>=99990.8.0-r100
	libcamera<99990.8.1
	fprintd
	diffutils
	qbootctl
	fprintd-pam
	libgusb
	pixman
	"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	libgusb-dev
	pixman-dev
	cairo-dev
	nss-dev
	openssl-dev
	libqmi-dev
	linux-headers
	meson
	protobuf-c-dev
	protobuf-dev
	python3-dev
	py3-gobject3
	py3-protobuf
	qrtr-dev
	"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
triggers="$pkgname.trigger=/usr/share/gnome-shell"
options="!check !tracedeps"
source="
	nura-g8x-tweaks-files.tar.gz
	hexagonrpc-$_hexver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$_hexver.tar.gz
	libssc-$_sscver.tar.gz::https://codeberg.org/DylanVanAssche/libssc/archive/v$_sscver.tar.gz
	hexagonrpc-0001-close-aliased-descriptor.diff
	hexagonrpc-0002-lg-sns-registry.diff
	libssc-0001-proximity-nonzero-is-near.diff
	libfprint-$_fpver.tar.gz::https://gitlab.freedesktop.org/libfprint/libfprint/-/archive/v$_fpver/libfprint-v$_fpver.tar.gz
	libfprint-0001-egis-et713.diff
	"
builddir="$srcdir"
_prefix=/usr/lib/nura-g8x

prepare() {
	default_prepare
	cd "$srcdir"/hexagonrpc-$_hexver
	patch -p0 < "$srcdir"/hexagonrpc-0001-close-aliased-descriptor.diff
	patch -p0 < "$srcdir"/hexagonrpc-0002-lg-sns-registry.diff
	cd "$srcdir"/libssc
	patch -p1 < "$srcdir"/libssc-0001-proximity-nonzero-is-near.diff
	cd "$srcdir"/libfprint-v$_fpver
	patch -p1 < "$srcdir"/libfprint-0001-egis-et713.diff
}

build() {
	# private copies under $_prefix: the system hexagonrpcd/libssc stay untouched
	cd "$srcdir"/hexagonrpc-$_hexver
	meson setup --prefix=$_prefix --libdir=lib --buildtype=release -Dc_link_args=-Wl,-rpath,$_prefix/lib output
	meson compile -C output
	cd "$srcdir"/libssc
	meson setup --prefix=$_prefix --libdir=lib --buildtype=release -Dc_link_args=-Wl,-rpath,$_prefix/lib output
	meson compile -C output
	# libfprint with the ET713 driver, private copy: fprintd gets it through LD_LIBRARY_PATH (fprintd drop-in)
	cd "$srcdir"/libfprint-v$_fpver
	meson setup --prefix=$_prefix --libdir=lib --buildtype=release -Ddrivers=egis_et713 \
		-Dintrospection=false -Ddoc=false -Dgtk-examples=false -Dinstalled-tests=false \
		-Dudev_rules=disabled -Dudev_hwdb=disabled output
	meson compile -C output
}

package() {
	DESTDIR="$srcdir"/stage meson install --no-rebuild -C "$srcdir"/hexagonrpc-$_hexver/output
	DESTDIR="$srcdir"/stage meson install --no-rebuild -C "$srcdir"/libssc/output
	DESTDIR="$srcdir"/stage meson install --no-rebuild -C "$srcdir"/libfprint-v$_fpver/output
	mkdir -p "$pkgdir"$_prefix/lib
	cp -a "$srcdir"/stage$_prefix/lib/libfprint-2.so.* "$pkgdir"$_prefix/lib/
	install -Dm755 "$srcdir"/stage$_prefix/bin/hexagonrpcd "$pkgdir"$_prefix/bin/hexagonrpcd
	cp -a "$srcdir"/stage$_prefix/lib/libhexagonrpc.so.* "$srcdir"/stage$_prefix/lib/libssc.so.* \
		"$pkgdir"$_prefix/lib/ 2>/dev/null || {
		mkdir -p "$pkgdir"$_prefix/lib
		cp -a "$srcdir"/stage$_prefix/lib/libhexagonrpc.so.* "$srcdir"/stage$_prefix/lib/libssc.so.* \
			"$pkgdir"$_prefix/lib/
	}

	local f="$srcdir"/files
	# settings app, helper, defaults
	install -Dm755 $f/tweaks/nura-tweaks "$pkgdir"/usr/bin/nura-tweaks
	install -Dm755 $f/tweaks/nura-tweaks-helper "$pkgdir"/usr/libexec/nura-tweaks-helper
	install -Dm644 $f/tweaks/tweaks.conf "$pkgdir"/usr/share/nura-g8x-tweaks/tweaks.conf
	install -Dm644 $f/tweaks/org.nura.G8xTweaks.desktop -t "$pkgdir"/usr/share/applications/
	install -Dm644 $f/tweaks/org.nura.g8x-tweaks.policy -t "$pkgdir"/usr/share/polkit-1/actions/
	install -Dm644 $f/tweaks/nura-tweaks-apply.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 $f/tweaks/nura-charge-limit.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 $f/tweaks/nura-tweaks-user.service -t "$pkgdir"/usr/lib/systemd/user/
	install -Dm644 $f/tweaks/80-nura-g8x.preset "$pkgdir"/usr/lib/systemd/system-preset/80-nura-g8x.preset
	install -Dm644 $f/tweaks/80-nura-g8x-user.preset "$pkgdir"/usr/lib/systemd/user-preset/80-nura-g8x.preset
	install -Dm644 $f/tweaks/52_waydroid.nft -t "$pkgdir"/etc/nftables.d/
	install -Dm755 $f/tweaks/nura-sensordaemon-fix "$pkgdir"/usr/libexec/nura-sensordaemon-fix

	# sensors: packaged hexagonrpcd/libssc, start check, gyroscope
	install -Dm644 $f/tweaks/sensors/hexagonrpcd-sdsp.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/50-nura-g8x.conf
	install -Dm644 $f/tweaks/sensors/iio-sensor-proxy.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/50-nura-g8x.conf
	install -Dm755 $f/unit/sensors/nura-sensor-check -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/sensors/nura-sensor-check.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm755 $f/unit/gyro/nura-gyro -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/gyro/nura-gyro.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 $f/unit/gyro/61-nura-gyro.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	# screen: touch and pocket guard, GNOME defaults
	install -Dm755 $f/unit/screen/nura-touch-guard "$pkgdir"/usr/bin/nura-touch-guard
	install -Dm644 $f/unit/screen/nura-touch-guard.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 $f/unit/screen/90_nura-g8x.gschema.override -t "$pkgdir"/usr/share/glib-2.0/schemas/

	# dock
	install -Dm755 $f/unit/dock/nura-dock -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/dock/nura-dock.service -t "$pkgdir"/usr/lib/systemd/user/
	install -Dm644 $f/unit/dock/72-nura-dock-backlight.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	# battery default (the helper writes /etc/udev/rules.d/ with your values)
	install -Dm644 $f/unit/battery/61-nura-charge-limit.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	# camera: PipeWire names, softISP tuning
	install -Dm644 $f/unit/camera/51-nura-cameras.conf -t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/
	# /etc is searched before /usr/share (libcamera-ipa owns files there)
	install -Dm644 $f/unit/camera/tuning/*.yaml -t "$pkgdir"/etc/libcamera/ipa/softisp/

	# suspend: Wi-Fi stays up in s2idle (WoWLAN), standby after screen off
	install -Dm755 $f/unit/suspend/nura-wifi-sleep -t "$pkgdir"/usr/lib/systemd/system-sleep/
	install -Dm755 $f/unit/suspend/nura-sensors-sleep -t "$pkgdir"/usr/lib/systemd/system-sleep/
	install -Dm755 $f/unit/standby/nura-standby -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/standby/90-nura-wifi-standby.conf -t "$pkgdir"/usr/lib/NetworkManager/conf.d/
	install -Dm644 $f/unit/standby/nura-standby.service -t "$pkgdir"/usr/lib/systemd/system/
	# first boot of a release image: LG firmware from the phone's partitions
	install -Dm755 $f/unit/firmware/nura-firmware-loader -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/firmware/nura-firmware-loader.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 $f/unit/firmware/socinfo/* -t "$pkgdir"/usr/share/qcom/sm8150/LG/mh2lm/socinfo/
	# USB network gadget with fixed MAC addresses (macOS names the interface reliably)
	install -Dm755 $f/unit/usbreplug/nura-usb-replug -t "$pkgdir"/usr/bin/
	install -Dm644 $f/unit/usbreplug/nura-usb-replug.service -t "$pkgdir"/usr/lib/systemd/system/
	# Dell TB16 RTL8153: Realtek's rtl8153a-3 PHY patch breaks gigabit; an invalid
	# file in updates/ wins over linux-firmware's .zst and r8152 skips the patch
	install -Dm644 $f/unit/r8153/rtl8153a-3.fw -t "$pkgdir"/usr/lib/firmware/updates/rtl_nic/
	install -Dm755 $f/unit/usbmac/nura-usb-mac -t "$pkgdir"/usr/bin/
	install -Dm644 $f/unit/usbmac/nura-usb-mac.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm755 $f/unit/firmware/nura-ath10k-board2 -t "$pkgdir"/usr/libexec/
	# 30 s hardware watchdog: a hung phone resets itself (power button is broken)
	install -Dm644 $f/unit/watchdog/50-nura-watchdog.conf -t "$pkgdir"/usr/lib/systemd/system.conf.d/
	# OTA: nura-update, and the updated /boot/boot.img goes to the active boot partition
	install -Dm755 $f/unit/ota/nura-update -t "$pkgdir"/usr/bin/
	install -Dm755 $f/unit/ota/nura-boot-update -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/ota/nura-boot-update.path $f/unit/ota/nura-boot-update.service -t "$pkgdir"/usr/lib/systemd/system/
	# fingerprint (ET713): egistad owns the trustlet, fprintd uses the private libfprint, lock-screen unlock
	install -Dm644 $f/unit/fingerprint/egistad/*.py -t "$pkgdir"/usr/lib/egistad/
	install -Dm644 $f/unit/fingerprint/egistad.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm755 $f/unit/fingerprint/nura-egista-seed $f/unit/fingerprint/nura-fp-reason \
		$f/unit/fingerprint/nura-fp-local -t "$pkgdir"/usr/libexec/
	install -Dm644 $f/unit/fingerprint/sudo.pam "$pkgdir"/etc/pam.d/sudo
	install -Dm644 $f/unit/fingerprint/sudo.pam "$pkgdir"/etc/pam.d/sudo-i
	install -Dm644 $f/unit/fingerprint/nura-egista.conf -t "$pkgdir"/usr/lib/modules-load.d/
	install -Dm644 $f/unit/fingerprint/fprintd-egista.conf \
		"$pkgdir"/usr/lib/systemd/system/fprintd.service.d/50-nura-egista.conf
	install -Dm644 $f/unit/fingerprint/gdm-fingerprint "$pkgdir"/etc/pam.d/gdm-fingerprint
	install -Dm644 $f/unit/fingerprint/g8x-fingerprint@nura/* \
		-t "$pkgdir"/usr/share/gnome-shell/extensions/g8x-fingerprint@nura/
	install -Dm644 $f/unit/fingerprint/91_nura-fingerprint.gschema.override -t "$pkgdir"/usr/share/glib-2.0/schemas/
	install -Dm644 $f/unit/fingerprint/profile-gdm "$pkgdir"/etc/dconf/profile/gdm
	install -Dm644 $f/unit/fingerprint/gdm.d-90-g8x-fingerprint "$pkgdir"/etc/dconf/db/gdm.d/90-g8x-fingerprint
}
sha512sums="
