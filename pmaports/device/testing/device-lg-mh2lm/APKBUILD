# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lg-mh2lm
pkgdesc="LG G8X ThinQ"
pkgver=1
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-nura-lg-mh2lm
	mkbootimg
	postmarketos-base
	nura-g8x-tweaks
	hexagonrpcd-systemd
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	qbootctl
	qbootctl-systemd
	qrtr
	rmtfs
	rmtfs-systemd
	tqftpserv
	tqftpserv-systemd
	wireless-regdb
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf modules-initfs sm8150-lg-mh2lm.dtb nura-g8x-2026.rsa.pub nura-g8x.list"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Built by build-dtb.py (base DTS + pmaports/*-fragment.dtsi, dtbo sink labels)
	install -Dm644 "$srcdir"/sm8150-lg-mh2lm.dtb \
		"$pkgdir"/boot/dtbs/qcom/sm8150-lg-mh2lm.dtb
	# Audio: ALSA UCM profile (without it PipeWire shows only "Dummy Output")
	install -Dm644 "$startdir/ucm/conf.d/sm8150/LG G8x ThinQ.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8150/LG G8x ThinQ.conf"
	install -Dm644 "$startdir"/ucm/LG/G8x/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/LG/G8x/HiFi.conf
	# Accelerometer mount matrix (screen rotation), haptics for feedbackd
	install -Dm644 "$startdir"/sensors/81-lg-mh2lm-accel-mount.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-lg-mh2lm-accel-mount.rules
	install -Dm644 "$startdir"/haptics/70-feedbackd-dw7800.rules \
		"$pkgdir"/usr/lib/udev/rules.d/70-feedbackd-dw7800.rules
	# Nura package repository (kernel, device, tweaks, patched libcamera): signing key and
	# URL, so "apk upgrade" updates them. Published by .github/workflows/images.yml.
	install -Dm644 "$startdir"/nura-g8x-2026.rsa.pub \
		"$pkgdir"/etc/apk/keys/nura-g8x-2026.rsa.pub
	install -Dm644 "$startdir"/nura-g8x.list \
		"$pkgdir"/etc/apk/repositories.d/nura-g8x.list
}
