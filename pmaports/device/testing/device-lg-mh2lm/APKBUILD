# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lg-mh2lm
pkgdesc="LG G8X ThinQ"
pkgver=1
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-nura-lg-mh2lm
	mkbootimg
	postmarketos-base
	nura-g8x-tweaks
	hexagonrpcd-systemd
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	qbootctl
	qbootctl-systemd
	qrtr
	rmtfs
	rmtfs-systemd
	tqftpserv
	tqftpserv-systemd
	wireless-regdb
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf modules-initfs sm8150-lg-mh2lm.dtb"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Built by build-dtb.py (base DTS + pmaports/*-fragment.dtsi, dtbo sink labels)
	install -Dm644 "$srcdir"/sm8150-lg-mh2lm.dtb \
		"$pkgdir"/boot/dtbs/qcom/sm8150-lg-mh2lm.dtb
}
