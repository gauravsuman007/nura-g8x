diff --git a/drivers/media/platform/qcom/camss/camss-vfe-17x.c b/drivers/media/platform/qcom/camss/camss-vfe-17x.c
index e5ee7e7..9f3974d 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-17x.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-17x.c
@@ -325,6 +325,8 @@ static void vfe_violation_read(struct vfe_device *vfe)
  *
  * Return IRQ_HANDLED on success
  */
+static int vfedbg;
+module_param(vfedbg, int, 0644);
 static irqreturn_t vfe_isr(int irq, void *dev)
 {
 	struct vfe_device *vfe = dev;
@@ -344,6 +346,9 @@ static irqreturn_t vfe_isr(int irq, void *dev)
 
 	/* Enforce ordering between IRQ reading and interpretation */
 	wmb();
+	if (vfedbg)
+		pr_info_ratelimited("vfedbg s0=%08x s1=%08x b0=%08x b1=%08x b2=%08x viol=%08x\n", status0, status1, vfe_bus_status[0], vfe_bus_status[1], vfe_bus_status[2], readl_relaxed(vfe->base + VFE_VIOLATION_STATUS));
+	if (vfedbg > 1) { int w; for (w = 0; w < 4; w++) pr_info_ratelimited("vfedbg wm%d st0=%08x st1=%08x cfg=%08x img=%08x w=%08x h=%08x pk=%08x str=%08x inc=%08x\n", w, readl_relaxed(vfe->base + VFE_BUS_WM_STATUS0(w)), readl_relaxed(vfe->base + VFE_BUS_WM_STATUS1(w)), readl_relaxed(vfe->base + VFE_BUS_WM_CFG(w)), readl_relaxed(vfe->base + VFE_BUS_WM_IMAGE_ADDR(w)), readl_relaxed(vfe->base + VFE_BUS_WM_BUFFER_WIDTH_CFG(w)), readl_relaxed(vfe->base + VFE_BUS_WM_BUFFER_HEIGHT_CFG(w)), readl_relaxed(vfe->base + VFE_BUS_WM_PACKER_CFG(w)), readl_relaxed(vfe->base + VFE_BUS_WM_STRIDE(w)), readl_relaxed(vfe->base + VFE_BUS_WM_FRAME_INC(w))); pr_info_ratelimited("vfedbg mask %08x %08x bus %08x %08x %08x core %08x\n", readl_relaxed(vfe->base + VFE_IRQ_MASK_0), readl_relaxed(vfe->base + VFE_IRQ_MASK_1), readl_relaxed(vfe->base + VFE_BUS_IRQ_MASK(0)), readl_relaxed(vfe->base + VFE_BUS_IRQ_MASK(1)), readl_relaxed(vfe->base + VFE_BUS_IRQ_MASK(2)), readl_relaxed(vfe->base + VFE_CORE_CFG)); }
 
 	writel_relaxed(CMD_GLOBAL_CLEAR, vfe->base + VFE_IRQ_CMD);
 	writel_relaxed(1, vfe->base + VFE_BUS_IRQ_CLEAR_GLOBAL);
