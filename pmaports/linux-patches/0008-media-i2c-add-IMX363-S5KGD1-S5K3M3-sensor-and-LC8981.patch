From ab353b15b6f5418dfe1f2328c9dc9c56d64b1c68 Mon Sep 17 00:00:00 2001
From: Gaurav Suman <gauravsuman007@gmail.com>
Date: Mon, 9 Nov 2026 10:30:09 +0000
Subject: [PATCH 08/12] media: i2c: add IMX363, S5KGD1, S5K3M3 sensor and
 LC898123F40 lens drivers

Part of the LG G8x ThinQ (lg-mh2lm) bring-up: https://github.com/gauravsuman007/nura-g8x
Written with the help of an AI coding assistant (Claude Opus 5.5).
---
 drivers/media/i2c/Kconfig       |   24 +
 drivers/media/i2c/Makefile      |    4 +
 drivers/media/i2c/imx363.c      | 1474 ++++++++
 drivers/media/i2c/lc898123.c    |  131 +
 drivers/media/i2c/s5k3m3-regs.h |   68 +
 drivers/media/i2c/s5k3m3.c      |  451 +++
 drivers/media/i2c/s5kgd1-regs.h | 6134 +++++++++++++++++++++++++++++++
 drivers/media/i2c/s5kgd1.c      |  451 +++
 8 files changed, 8737 insertions(+)
 create mode 100644 drivers/media/i2c/imx363.c
 create mode 100644 drivers/media/i2c/lc898123.c
 create mode 100644 drivers/media/i2c/s5k3m3-regs.h
 create mode 100644 drivers/media/i2c/s5k3m3.c
 create mode 100644 drivers/media/i2c/s5kgd1-regs.h
 create mode 100644 drivers/media/i2c/s5kgd1.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5eb1e0e..d91b740 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -257,6 +257,30 @@ config VIDEO_IMX335
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx335.
 
+config VIDEO_IMX363
+	tristate "Sony IMX363 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  Sony IMX363 camera sensor.
+
+config VIDEO_S5KGD1
+	tristate "Samsung S5KGD1 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  Samsung S5KGD1 camera sensor.
+
+config VIDEO_LC898123
+	tristate "LC898123F40 lens actuator"
+	select V4L2_CCI_I2C
+	help
+	  LC898123F40 OIS/AF controller (autofocus only).
+
+config VIDEO_S5K3M3
+	tristate "Samsung S5K3M3 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  Samsung S5K3M3 camera sensor.
+
 config VIDEO_IMX355
 	tristate "Sony IMX355 sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index a3a6396..0373c0c 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -169,3 +169,7 @@ obj-$(CONFIG_VIDEO_VP27SMPX) += vp27smpx.o
 obj-$(CONFIG_VIDEO_VPX3220) += vpx3220.o
 obj-$(CONFIG_VIDEO_WM8739) += wm8739.o
 obj-$(CONFIG_VIDEO_WM8775) += wm8775.o
+obj-$(CONFIG_VIDEO_IMX363) += imx363.o
+obj-$(CONFIG_VIDEO_S5KGD1) += s5kgd1.o
+obj-$(CONFIG_VIDEO_LC898123) += lc898123.o
+obj-$(CONFIG_VIDEO_S5K3M3) += s5k3m3.o
