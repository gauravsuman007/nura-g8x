# nura-g8x-tweaks: postmarketOS applies presets after installs; keep ours on.
enable nura-tweaks-apply.service
enable nura-gyro.service
enable nura-touch-guard.service
enable nura-sensor-check.service
enable nura-standby.service
enable nura-firmware-loader.service
enable nura-usb-mac.service
enable nura-charge-limit.service
enable egistad.service
enable nura-boot-update.path
# cellular: LG SIM handshake, clock from the network time
enable nura-lge-modem.service
enable nura-cell-time.timer
