#!/usr/bin/python3
"""LG G8x Tweaks: settings for the Nura LG G8x userspace tweaks.

Reads /etc/nura/tweaks.conf (via nura-tweaks-helper get) and saves changes
with `pkexec nura-tweaks-helper set KEY=VALUE`, which validates and applies
them. The page is grouped like GNOME Settings.
"""
import subprocess
import sys

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

