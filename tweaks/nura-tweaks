#!/usr/bin/python3
"""LG G8x Tweaks: settings for the Nura LG G8x userspace tweaks.

Reads /etc/nura/tweaks.conf (via nura-tweaks-helper get) and saves changes
with `pkexec nura-tweaks-helper set KEY=VALUE`, which validates and applies
them. The page is grouped like GNOME Settings.
"""
import subprocess
import sys

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, GLib, Gtk  # noqa: E402

HELPER = '/usr/libexec/nura-tweaks-helper'

# (group title, group description, [(key, kind, title, subtitle, min, max, step)])
PAGES = [
    ('Buttons', 'For phones with a broken power button', [
        ('POWER_KEY', 'switch', 'Assistant key as power button',
         'Press: screen off or on. Hold: power menu'),
        ('POWER_HOLD_MS', 'spin', 'Assistant press time',
         'Milliseconds before it counts as a power press', 50, 3000, 50),
        ('RESET_COMBO', 'switch', 'Restart combo',
         'Hold Assistant + Volume Down to restart, even when frozen'),
        ('RESET_HOLD_MS', 'spin', 'Restart combo hold time',
         'Milliseconds', 3000, 20000, 500),
    ]),
    ('Wake and Pocket', None, [
        ('WAKE_KEYS', 'switch', 'Wake with Volume Up or Assistant',
         'Wake the phone from suspend'),
        ('TOUCH_GUARD', 'switch', 'Ignore touch while the screen is off', None),
        ('POCKET_GUARD', 'switch', 'Pocket detection',
         'Ignore the volume keys while the screen is off and covered'),
    ]),
    ('Dock', 'USB-C DisplayPort docks and adapters', [
        ('DOCK_AUTO', 'switch', 'Docked desktop',
         'The external monitor becomes the main desktop'),
        ('DOCK_PANEL_OFF', 'switch', 'Phone screen off while docked',
         'Saves power and heat'),
        ('DOCK_POWER_KEY_OFF', 'switch', 'Power key off while docked',
         'Suspending while docked can leave the dock unresponsive'),
        ('DOCK_STUCK_WARN', 'switch', 'Warn when the dock stops responding', None),
    ]),
    ('Battery', 'Turn the limit on in Settings, Power, "Preserve Battery Health"', [
        ('CHARGE_LIMIT_START', 'spin', 'Resume charging below', 'Percent', 20, 95, 5),
        ('CHARGE_LIMIT_END', 'spin', 'Stop charging at', 'Percent', 25, 100, 5),
    ]),
    ('Sensors', None, [
        ('GYRO', 'switch', 'Gyroscope', 'Motion input for games and apps'),
        ('SENSOR_CHECK', 'switch', 'Sensor start check',
         'Alert at boot when auto-brightness, rotation and proximity failed to start'),
    ]),
]


def read_settings():
    out = subprocess.run([HELPER, 'get'], capture_output=True, text=True).stdout
    return dict(l.split('=', 1) for l in out.splitlines() if '=' in l)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='LG G8x Tweaks')
        self.set_default_size(420, 760)
        self.values = read_settings()
        self.rows = {}
        self.pending = {}
        self.timer = 0
        self.loading = True

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        for title, desc, items in PAGES:
            group = Adw.PreferencesGroup(title=title)
            if desc:
                group.set_description(desc)
            for key, kind, label, sub, *rng in items:
                group.add(self.make_row(key, kind, label, sub, rng))
            page.add(group)
        view.set_content(page)
        self.toasts.set_child(view)
        self.set_content(self.toasts)
        self.loading = False

    def make_row(self, key, kind, label, sub, rng):
        val = self.values.get(key, '0')
        if kind == 'switch':
            row = Adw.SwitchRow(title=label)
            row.set_active(val == '1')
            row.connect('notify::active', self.on_change, key)
        else:
            lo, hi, step = rng
            row = Adw.SpinRow.new_with_range(lo, hi, step)
            row.set_title(label)
            row.set_value(int(val or lo))
            row.connect('notify::value', self.on_change, key)
        if sub:
            row.set_subtitle(sub)
        self.rows[key] = row
        return row

    def on_change(self, row, _pspec, key):
        if self.loading:
            return
        v = str(int(row.get_active())) if isinstance(row, Adw.SwitchRow) \
            else str(int(row.get_value()))
        self.pending[key] = v
        if self.timer:
            GLib.source_remove(self.timer)
        # spin rows change on every click: save once they settle
        self.timer = GLib.timeout_add(700, self.save)

    def save(self):
        self.timer = 0
        args = ['%s=%s' % kv for kv in self.pending.items()]
        self.pending = {}
        r = subprocess.run(['pkexec', HELPER, 'set'] + args,
                           capture_output=True, text=True)
        if r.returncode == 0:
            self.toasts.add_toast(Adw.Toast(title='Saved', timeout=1))
        else:
            msg = r.stderr.strip().splitlines()[-1] if r.stderr.strip() else 'Not saved'
            self.toasts.add_toast(Adw.Toast(title=msg))
            self.reload()
        return False

    def reload(self):
        self.loading = True
        self.values = read_settings()
        for key, row in self.rows.items():
            v = self.values.get(key, '0')
            if isinstance(row, Adw.SwitchRow):
                row.set_active(v == '1')
            else:
                row.set_value(int(v))
        self.loading = False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id='org.nura.G8xTweaks')

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
