#!/usr/bin/python3
"""Docked mode for GNOME Mobile (Nura, LG G8x).

When an external monitor (USB-C DisplayPort dock or adapter) appears, make it
the primary screen so GNOME switches to its desktop layout there, at the
largest mode with at least 50 Hz, with the phone panel to its right. The
config is applied as temporary, so on unplug Mutter falls back to the phone
panel alone by itself. Runs in the user session (systemd --user).

While docked:
- the phone panel is dark (bl_power off; nothing usable is drawn there, it
  only costs power and heat). Removing the panel from the Mutter config
  instead hard-hung the phone (2026-11-12), so the output stays configured.
- the power key does nothing: a suspend with a dock attached broke the resume
  (USB-C PHY timeout, DP stall, wedged dock). The previous action is saved to
  a state file and restored on undock.
Stuck dock warnings (a phone replug does not help, only a dock power cycle):
- pin assignment D but no SuperSpeed device after 12 s, or
- power on the port but no Type-C partner for 15 s.
In both cases the phone panel is kept on.
Each behaviour can be turned off in LG G8x Tweaks (/etc/nura/tweaks.conf,
read on every event: DOCK_AUTO, DOCK_PANEL_OFF, DOCK_POWER_KEY_OFF,
DOCK_STUCK_WARN).
"""
import os
from gi.repository import Gio, GLib

NAME = 'org.gnome.Mutter.DisplayConfig'
PATH = '/org/gnome/Mutter/DisplayConfig'
BL_POWER = '/sys/class/backlight/r66456-bl/bl_power'
bus = Gio.bus_get_sync(Gio.BusType.SESSION)
POWER = Gio.Settings.new('org.gnome.settings-daemon.plugins.power')
STATE = os.path.join(GLib.get_user_state_dir(), 'nura-dock', 'power-button-action')
STUCK_BODY = ("Unplug the dock's power for a few seconds, plug it back in, "
              "then reconnect the phone.")
docked = False
dock_stuck = False   # keep the phone panel usable after a warning
vbus_alone = 0       # seconds with power on the port but no Type-C partner


def log(*a):
    print('nura-dock:', *a, flush=True)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ''


def tweak(key, default='1'):
    for line in read('/etc/nura/tweaks.conf').splitlines():
        k, _, v = line.partition('=')
        if k.strip() == key:
            return v.split('#')[0].strip() == '1'
    return default == '1'


def call(method, args=None):
    return bus.call_sync(NAME, PATH, NAME, method, args, None, 0, -1, None).unpack()


def notify(title, body):
    try:
        bus.call_sync('org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                      'org.freedesktop.Notifications', 'Notify',
                      GLib.Variant('(susssasa{sv}i)', (
                          'Dock', 0, 'video-display', title, body,
                          [], {'urgency': GLib.Variant('y', 2)}, 0)),
                      None, 0, -1, None)
    except GLib.Error as e:
        log('notify failed:', e.message)


def panel_dark(dark):
    if dark and not tweak('DOCK_PANEL_OFF'):
        dark = False
    want = '4' if dark else '0'
    if read(BL_POWER) in ('', want):
        return
    try:
        with open(BL_POWER, 'w') as f:
            f.write(want)
        log('phone panel', 'off' if dark else 'on')
    except OSError as e:
        log('bl_power:', e)


def set_docked(on):
    global docked, dock_stuck
    if on == docked:
        return
    docked = on
    if on and tweak('DOCK_POWER_KEY_OFF'):
        cur = POWER.get_string('power-button-action')
        if cur != 'nothing' and not os.path.exists(STATE):
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            with open(STATE, 'w') as f:
                f.write(cur)
        POWER.set_string('power-button-action', 'nothing')
        log('power key disabled while docked')
    if on:
        GLib.timeout_add_seconds(12, check_dock_usb)
    else:
        dock_stuck = False
        restore_power_key()
    panel_dark(on)


def restore_power_key():
    try:
        with open(STATE) as f:
            prev = f.read().strip()
    except OSError:
        return
    POWER.set_string('power-button-action', prev or 'suspend')
    os.unlink(STATE)
    log('power key restored:', prev)


def stuck(why, body):
    global dock_stuck
    dock_stuck = True
    log(why, '- dock looks stuck')
    panel_dark(False)
    if tweak('DOCK_STUCK_WARN'):
        notify('Dock not responding', body)


def check_dock_usb():
    """Pin assignment D means the dock also runs USB3 over the same PHY."""
    if not docked:
        return False
    base = '/sys/bus/typec/devices'
    pins = [read(os.path.join(base, d, 'displayport/pin_assignment'))
            for d in (os.listdir(base) if os.path.isdir(base) else [])]
    if not any('[D]' in p for p in pins):
        return False
    usb = '/sys/bus/usb/devices'
    ss = [h for h in os.listdir(usb) if h.startswith('usb')
          and read(f'{usb}/{h}/speed') in ('5000', '10000', '20000')]
    if any(c[0].isdigit() and ':' not in c
           for h in ss for c in os.listdir(f'{usb}/{h}')):
        return False
    stuck('dock USB3 did not come up', 'The monitor may stay blank. ' + STUCK_BODY)
    return False


def check_vbus_alone():
    """A working dock or charger always shows up as a Type-C partner."""
    global vbus_alone
    vbus = read('/sys/class/power_supply/pm8150b-charger/online') == '1'
    if vbus and not os.path.exists('/sys/class/typec/port0-partner'):
        vbus_alone += 5
        if vbus_alone == 15:
            stuck('power on the port but no Type-C partner', STUCK_BODY)
    else:
        vbus_alone = 0
    if docked and not dock_stuck:
        panel_dark(True)   # GNOME's unblank may have turned it back on
    return True


def builtin(conn, props):
    return props.get('is-builtin', False) or conn.startswith(('DSI', 'eDP'))


def apply_docked():
    if not tweak('DOCK_AUTO'):
        set_docked(False)
        return
    serial, monitors, logical, _ = call('GetCurrentState')
    ext = panel = None
    for (conn, _v, _p, _s), modes, props in monitors:
        if builtin(conn, props):
            panel = (conn, modes)
        elif ext is None:
            ext = (conn, modes)
    set_docked(ext is not None)
    if not ext:
        return
    for l in logical:
        if l[4] and any(m[0] == ext[0] for m in l[5]):
            return  # already docked
    # mode tuple: id, width, height, refresh, preferred scale, supported scales, props
    good = [m for m in ext[1] if m[3] >= 49.5] or ext[1]
    best = max(good, key=lambda m: (m[1] * m[2], m[3]))
    scale = 2.0 if best[1] >= 3840 else 1.0
    if scale not in best[5]:
        scale = best[4]
    lm = [(0, 0, scale, 0, True, [(ext[0], best[0], {})])]
    if panel:
        cur = [m for m in panel[1] if m[6].get('is-current')] or panel[1][:1]
        pl = [l for l in logical if any(m[0] == panel[0] for m in l[5])]
        pscale, ptrans = (pl[0][2], pl[0][3]) if pl else (cur[0][4], 0)
        lm.append((int(round(best[1] / scale)), 0, pscale, ptrans, False,
                   [(panel[0], cur[0][0], {})]))
    log('docked:', ext[0], best[0], 'scale', scale)
    try:
        call('ApplyMonitorsConfig',
             GLib.Variant('(uua(iiduba(ssa{sv}))a{sv})', (serial, 1, lm, {})))
    except GLib.Error as e:
        log('apply failed:', e.message)


def changed(*_):
    # let Mutter settle (hotplug sends several updates)
    GLib.timeout_add(800, lambda: (apply_docked(), False)[1])


def appeared(*_):
    bus.signal_subscribe(NAME, NAME, 'MonitorsChanged', PATH, None, 0, changed)
    changed()


restore_power_key()  # a crash or reboot while docked
panel_dark(False)
GLib.timeout_add_seconds(5, check_vbus_alone)
Gio.bus_watch_name_on_connection(bus, NAME, 0, appeared, None)
GLib.MainLoop().run()
